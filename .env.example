# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kisan_mitra

# Authentication Secret
JWT_SECRET=kisan_mitra_jwt_super_secure_secret_key_change_in_production_2026

# AI Configuration (Google Gemini API)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Government Open Data API Key (Optional, for live Agmarknet data.gov.in integration)
DATA_GOV_IN_API_KEY=

# Client Base URL (for CORS)
CLIENT_URL=http://localhost:5173
